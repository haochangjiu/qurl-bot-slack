# --- Slack App Directory: OAuth + Socket Mode ---
# App credentials: api.slack.com/apps → Basic Information
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Socket Mode: App-Level Token (xapp-..., scope connections:write)
SLACK_APP_TOKEN=

# Redirect URL under OAuth & Permissions (must match exactly; use HTTPS in production)
# Example: https://your.domain/slack/oauth_redirect
SLACK_REDIRECT_URI=

# Optional: comma-separated bot scopes (defaults match README)
# SLACK_BOT_SCOPES=app_mentions:read,chat:write,im:history,im:read,im:write,users:read,commands

# OAuth: file-based installation store (per-workspace bot tokens)
# SLACK_INSTALLATION_BASE_DIR=data/slack_installations

# Per-workspace LayerV keys (encrypted JSON)
# WORKSPACE_LAYERV_KEYS_PATH=data/workspace_layerv_keys.json

# OAuth CSRF state files (short-lived)
# OAUTH_STATE_DIR=data/oauth_state

# HTTP server (OAuth install + callback only; events use Socket Mode)
# HTTP_HOST=0.0.0.0
# HTTP_PORT=8080

# Optional: browser redirect after install (landing / success page)
# OAUTH_SUCCESS_URL=https://your.site/slack-installed
# OAUTH_FAILURE_URL=https://your.site/slack-oauth-error

# Temporary testing only: disable TLS verification for Slack API / Socket Mode (insecure)
# SLACK_INSECURE_SSL=false

# Claude (message understanding)
ANTHROPIC_API_KEY=

# LayerV QURL (optional global fallback when no workspace key is stored)
LAYERV_API_URL=https://api.layerv.xyz
LAYERV_API_KEY=
LAYERV_STATS_URL=https://layerv.ai/qurl/dashboard

# QURL Default Settings
QURL_DEFAULT_EXPIRES_IN=30m

# Change in production
ENCRYPTION_SECRET=your-random-secret-string

# --- LayerV key commands (/setkey, /mykey, /delkey in DM only) ---
# Enterprise Grid: default check uses users.info → enterprise_user (org-level Owner/Admin); bot scope users:read is enough.
# Non–Enterprise Grid: workspace Primary Owner / Owner / Admin may configure when true; set false to allow only Enterprise org admins (or use LAYERV_API_KEY env).
# LAYERV_KEY_ALLOW_WORKSPACE_ADMIN_IF_NOT_ENTERPRISE_GRID=true

# Optional: admin.roles.listAssignments fallback (Enterprise org install + user token with admin.roles:read)
# USE_ADMIN_ROLES_API_FALLBACK=false
# SLACK_ADMIN_USER_TOKEN=xoxp-...   # user OAuth token — never commit
# SLACK_ORG_ADMIN_ROLE_IDS=Rl01,Rl02  # comma-separated role_id from admin.roles.list (e.g. Organization Admin)
